# Конфиг для BeGet (Apache). Локально используется nginx — он этот файл игнорирует.
# На BeGet к этому файлу панель может добавлять свои блоки (выбор версии PHP,
# SSL-редирект) — их не трогаем, наши правила ниже с ними сосуществуют.

# Статичные .txt (llms.txt) — в UTF-8, иначе кириллица превращается в кракозябры.
AddCharset utf-8 .txt

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Склейка зеркал: www.psm-carbon.ru → psm-carbon.ru (301, путь и query сохраняются).
    # Проверяем хост, а не протокол — после редиректа хост другой, цикла нет.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Существующие файлы (index.html, assets/ …) отдаём напрямую.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Всё остальное — на единственную точку входа Symfony.
    # Дальше роутинг решит: API или отдать index.html (React SPA).
    RewriteRule ^ index.php [L]
</IfModule>
